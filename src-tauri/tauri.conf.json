{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spark",
  "version": "0.1.0",
  "identifier": "com.spark.notes",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Spark",
        "width": 480,
        "height": 140,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "focus": false
      },
      {
        "label": "history",
        "title": "Spark 历史记录",
        "url": "history.html",
        "width": 520,
        "height": 560,
        "minWidth": 360,
        "minHeight": 280,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
